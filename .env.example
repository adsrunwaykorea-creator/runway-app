# ------------------------------------------------------------
# Toss Payments - TEST MODE (default during PG review)
# ------------------------------------------------------------
# IMPORTANT:
# - Keep NEXT_PUBLIC_TOSS_CLIENT_KEY and TOSS_SECRET_KEY in the SAME mode.
# - Do not mix test_* with live_* keys.
# - During PG review, use test keys only.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_xxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Required for admin operations; lead form API falls back to anon key if unset.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Comma-separated admin emails for production access (optional, with profiles.role admin/manager)
# ADMIN_EMAILS=ads.runwaykorea@gmail.com,owner@example.com
# One-time: create consultation_leads table (Dashboard → Settings → Database password)
# SUPABASE_DB_PASSWORD=your_database_password
# Or: DATABASE_URL=postgresql://postgres.[ref]:[password]@...

# ------------------------------------------------------------
# Kakao Pay (/checkout)
# ------------------------------------------------------------
KAKAO_PAY_ADMIN_KEY=your_kakao_pay_admin_secret_key
KAKAO_PAY_CID=TC0ONETIME
NEXT_PUBLIC_SITE_URL=https://runwayads.kr

# ------------------------------------------------------------
# Meta Pixel (ads conversion tracking)
# ------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=961431116511023

# ------------------------------------------------------------
# Live switch checklist (after PG approval)
# ------------------------------------------------------------
# 1) NEXT_PUBLIC_TOSS_CLIENT_KEY -> live_gck_...
# 2) TOSS_SECRET_KEY             -> live_sk_...
# 3) Restart server after replacing both keys.
